#!/usr/bin/env bash
# Format: <title>, then optional blank line + <description> and/or "Close #<issue>". See .gitmessage.
msg=$(grep -v '^#' "$1")

fail() { echo "✖ Commit message: $1 (see .gitmessage)" >&2; exit 1; }
[[ -n $(sed -n 1p <<<"$msg") ]] || fail "title is required"
[[ -z $(sed -n 2p <<<"$msg") ]] || fail "line 2 must be blank"
