#!/usr/bin/env bash
# Format: <label>: <title>, then optional blank line + <description> and/or "Close #<issue>". See .gitmessage.
labels="feature|bug|chore|docs"
msg=$(grep -v '^#' "$1")
title=$(sed -n 1p <<<"$msg")

fail() { echo "✖ Commit message: $1 (see .gitmessage)" >&2; exit 1; }
[[ -n $title ]] || fail "title is required"
# Merge and Revert titles are generated by git, so they skip the label check.
[[ $title =~ ^(Merge|Revert)\  || $title =~ ^($labels):\ [^[:space:]] ]] ||
  fail "title must start with a label (${labels//|/, }), e.g. \"feature: Add login page\""
[[ -z $(sed -n 2p <<<"$msg") ]] || fail "line 2 must be blank"
